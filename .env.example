# VOICEPRINT — Server-Side Environment Variables Template
# Copy this file to .env and configure your secrets.
# NEVER commit .env to version control or prefix secrets with VITE_

# Server Configuration
PORT=3002
NODE_ENV=development

# Gemma 4 Model Provider Configuration
# Supported providers: "google" (default), "ollama", "openai_compatible", "local_grounded"
GEMMA_PROVIDER=google

# Gemma Model Name: Official Google AI Studio identifiers: "gemma-4-31b-it" or "gemma-4-26b-a4b-it"
GEMMA_MODEL=gemma-4-31b-it

# Server-Side API Key for Google AI Studio / Gemini API (if using "google" provider)
# NEVER prefix with VITE_ so it is NEVER bundled into frontend JavaScript
GEMMA_API_KEY=

# Custom API Base URL (optional, for Ollama or custom OpenAI-compatible proxy)
# e.g., http://localhost:11434 for Ollama, or https://openrouter.ai/api/v1
GEMMA_API_BASE=

# Model Temperature (0.0 - 1.0, recommended 0.2 for strict factual grounding)
GEMMA_TEMPERATURE=0.2

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=30
